# Telegram (required)
BOT_TOKEN=put_your_token_from_BotFather_here

# Optional outbound proxy (helpful for RU server connectivity)
# HTTPS_PROXY=http://user:pass@proxy.example.com:3128

# Postgres
POSTGRES_PASSWORD=changeme_strong_password
# When running docker-compose, DATABASE_URL is built automatically.
# For local dev:
# DATABASE_URL=postgres://kruto52:changeme_strong_password@localhost:5432/kruto52

# Admin Telegram IDs (comma-separated) — gain access to /stats and /grant_*
ADMIN_USER_IDS=

# Worker
# Threads per C worker process. Default (when unset) = floor(N_CPU / 2)
# so that two parallel searches share cores fairly. Set to 0 to use all
# cores (single-tenant local dev). Set explicitly for predictable VPS load.
#
# Recommended for a 2-vCPU VPS:
#   WORKER_THREADS=2        # use both vCPUs per live search
#   BOT_CPUS=1.8            # leave 0.2 vCPU for postgres bursts
#   LIVE_SEARCH_CONCURRENCY=1  # only one live search at a time
# Combined with the LIVE_SEARCH_CONCURRENCY=1 semaphore, this keeps the
# bot responsive (Node async I/O never starves) while doubling per-search
# throughput vs the legacy single-thread default.
# WORKER_THREADS=4
SEARCH_TIMEOUT_MS=60000   # max per live search; SEARCH_MAX_SEEDS unset → no seed cap

# Concurrent live searches (cache misses) allowed at once. Cache and memo
# hits do NOT count toward this limit. Default (when unset) = N_CPU / WORKER_THREADS,
# capped at 4. Excess requests queue FIFO.
# LIVE_SEARCH_CONCURRENCY=2

# Precompute
PRECOMPUTE_ENABLED=true
PRECOMPUTE_INTERVAL_SEC=600
PRECOMPUTE_BATCH_SIZE=200

# Free tier
FREE_DAILY_HITS=2

# CryptoBot (optional — Telegram Stars work without these)
# CRYPTOBOT_TOKEN=
# CRYPTOBOT_WEBHOOK_SECRET=

# Health endpoint for Docker healthcheck + external uptime monitors.
# Set HEALTH_PORT=0 to disable the server entirely.
HEALTH_PORT=8080

# docker-compose resource limits (override per host).
# 2-vCPU / 4 GB VPS profile:
#   BOT_CPUS=1.8
#   BOT_MEM=2g
#   POSTGRES_CPUS=0.5
#   POSTGRES_MEM=512m
# BOT_CPUS=4.0
# BOT_MEM=2g
# POSTGRES_CPUS=1.0
# POSTGRES_MEM=1g

LOG_LEVEL=info
